import sys

def main():
    for line in sys.stdin:
        try:
            line = line.strip()
            if not line:
                continue

            num = int(line)

            if num % 2 == 0:
                print(f"{num} Even")
            else:
                print(f"{num} Odd")

        except ValueError:
            sys.exit(1)

if __name__ == '__main__':
    main()
